{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Local desktop window with updater and deep-link support",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "deep-link:default",
    "dialog:allow-open",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "https://x.brandct.com/generalSettings/personalAccessTokens"
        },
        {
          "url": "https://lightdash.banmahui.cn/generalSettings/personalAccessTokens"
        },
        {
          "url": "https://github.com/winwin-inc/power-switch"
        },
        {
          "url": "https://github.com/winwin-inc/power-switch/releases/tag/v*"
        }
      ]
    },
    "process:allow-restart"
  ]
}
