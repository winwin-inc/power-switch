{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "power-switch",
  "version": "0.1.6-rc.2",
  "identifier": "com.powerswitch.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev:web",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build:web",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "power-switch",
        "width": 1120,
        "height": 780,
        "minWidth": 800,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost; font-src 'self' data:",
      "devCsp": "default-src 'self'; script-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost ws://localhost:1420 ws://127.0.0.1:1420; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "windows": {
      "wix": {
        "version": "0.1.6.2"
      }
    },
    "shortDescription": "模型随心切换",
    "category": "DeveloperTool",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "deep-link": { "desktop": { "schemes": ["power-switch"] } },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDgzQkZFRDA2NTQ2REQ0MjkKUldRcDFHMVVCdTIvZytKUnNyWVJHS21OT1l4emE2NjhZSTdSMDdDV0ROTGNaOExya2dYM2FFUXYK",
      "endpoints": [
        "https://github.com/winwin-inc/power-switch/releases/latest/download/latest.json"
      ],
      "windows": { "installMode": "passive" }
    }
  }
}
